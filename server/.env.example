# Ambiente: development | test | production
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth (JWKS) — obrigatório
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# ---------------------------------------------------------------------------
# Postgres — TLS com verificação (recomendado)
# Use o Connection pooler (Settings → Database):
#   Host: aws-0-<region>.pooler.supabase.com
#   Port: 6543 (Transaction) ou 5432 (Session)
#   User: audita_app (após migração 006) ou postgres.<project-ref> no pooler
# Exemplo:
# DATABASE_URL=postgresql://audita_app:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#
# Evite db.<ref>.supabase.co:5432 (direto) — costuma falhar cadeia TLS no Node.
# Se precisar do host direto, forneça PEM em DATABASE_SSL_CA.
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_SSL_CA=
# Só development/test — NUNCA em produção
DATABASE_SSL_INSECURE=false

# eSocial (mock nesta etapa)
ESOCIAL_AMBIENTE=producao_restrita
ESOCIAL_TRANSPORT_MOCK=true
ESOCIAL_ALLOW_REAL_CALLS=
ESOCIAL_CERT_PFX_PATH=
ESOCIAL_CERT_PASSWORD=
ESOCIAL_EMPREGADOR_CNPJ=
ESOCIAL_ALLOWED_COMPANY_IDS=

STORAGE_DIR=./data/xmls
BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info
