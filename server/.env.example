# Ambiente: development | test | production
NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Origens CORS permitidas (frontend Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth real da API eSocial (NÃO é o login demo do frontend)
AUDITA_API_USER=audita-ops
AUDITA_API_PASSWORD=troque-esta-senha
AUDITA_JWT_SECRET=troque-por-segredo-longo-aleatorio-min-32-chars
AUDITA_JWT_TTL_SECONDS=3600

# eSocial
# producao_restrita | producao
ESOCIAL_AMBIENTE=producao_restrita
# Se true, nunca chama o governo (útil em CI). Smoke real exige false + confirmação.
ESOCIAL_TRANSPORT_MOCK=true
# Gate explícito para HTTPS oficial (só vale com TRANSPORT_MOCK=false). Use "yes" para liberar.
ESOCIAL_ALLOW_REAL_CALLS=

# Certificado A1 local (dev) — NÃO commitar o arquivo
# Caminho absoluto ou relativo ao /server
ESOCIAL_CERT_PFX_PATH=
ESOCIAL_CERT_PASSWORD=

# CNPJ do empregador autorizado para a primeira consulta (somente dígitos, 14)
ESOCIAL_EMPREGADOR_CNPJ=
# Mapeamento companyId frontend -> permitido (CSV). Ex.: 1,2,5
ESOCIAL_ALLOWED_COMPANY_IDS=1

# Persistência (Supabase Postgres)
# Settings → Database → Connection string (URI) — use a senha do projeto
# Ex.: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Diretório de storage privado de XMLs
STORAGE_DIR=./data/xmls

# Limites
BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info
